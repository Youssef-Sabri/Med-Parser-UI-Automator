# Backend Settings
PORT=8000
DEBUG=False

# Security Key for API authentication
MED_PARSER_API_KEY=your_secure_api_key_here

# Encryption Key for sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MED_PARSER_SECRET_KEY=your_base64_fernet_key_here

# File Storage
STAGING_DIR=./staging
MAX_UPLOAD_SIZE_MB=50
BRIDGE_AGENT_URL=http://localhost:8001

# AI Model Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-1.5-flash
GEMINI_TIMEOUT=15
EXTRACTION_CONCURRENCY_LIMIT=3


# Database Connection
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Frontend Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MED_PARSER_API_KEY=your_secure_api_key_here

# Automation & RPA Settings
# Title of the application the bot will type into
PMS_TARGET_TITLE=Notepad

# Typing speed (seconds per character)
TYPING_SPEED_MIN=0.0
TYPING_SPEED_MAX=0.05


# Emergency Stop Hotkey
ABORT_HOTKEY=ctrl+shift+z

# Configurable RPA Shortcuts for your Pharmacy Management System (PMS)
RPA_SAVE_HOTKEY=ctrl+s
RPA_CLOSE_HOTKEY=alt+f4
RPA_SELECT_ALL_HOTKEY=ctrl+a

# ── Newly Required Zero-Fallback Variables ──
BRIDGE_PORT=8001
BACKEND_URL=http://localhost:8000
MAX_CAPACITY=50000

# Daily throughput ceiling for the "Daily Capacity Usage" gauge in the UI.
# Set this to the realistic number of prescriptions your site processes per day.
# Default: 200 (a typical community pharmacy volume).
MAX_DAILY_CAPACITY=200
