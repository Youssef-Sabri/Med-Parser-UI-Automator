# ── Backend Configuration ────────────────────────────────────────────────
PORT=8000
DEBUG=False

# Authorization Key (X-API-KEY header)
MED_PARSER_API_KEY=your_secure_api_key_here

# PHI Encryption Key (AES-256 Fernet key for HIPAA-compliant storage)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MED_PARSER_SECRET_KEY=your_base64_fernet_key_here

# Staging & Storage
STAGING_DIR=./staging
MAX_UPLOAD_SIZE_MB=50
BRIDGE_AGENT_URL=http://localhost:8001

# ── AI API & Model ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=models/gemini-3.1-flash-lite-preview
GEMINI_TIMEOUT=30
EXTRACTION_CONCURRENCY_LIMIT=3

# ── Database (Supabase Connection Pooler) ──────────────────────────────
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@your_host.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Frontend & Network ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MED_PARSER_API_KEY=your_secure_api_key_here

# ── Automation RPA & Performance ─────────────────────────────────────────
PMS_TARGET_TITLE=Notepad
TYPING_SPEED_MIN=0.01
TYPING_SPEED_MAX=0.02

# Emergency Stop
ABORT_HOTKEY=ctrl+shift+z

# Configurable RPA Shortcuts
RPA_SAVE_HOTKEY=ctrl+s
RPA_CLOSE_HOTKEY=alt+f4
RPA_SELECT_ALL_HOTKEY=ctrl+a

# ── Zero-Fallback Variables ──
BRIDGE_PORT=8001
BACKEND_URL=http://localhost:8000
MAX_CAPACITY=50000
MAX_DAILY_CAPACITY=200
