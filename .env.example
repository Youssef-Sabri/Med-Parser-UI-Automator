# ── 1. Backend Core & Security ──────────────────────────────────────────
PORT=8000
DEBUG=False
MED_PARSER_API_KEY=your_secure_api_key_here
# Generate 32-byte Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MED_PARSER_SECRET_KEY=your_base64_fernet_key_here
STAGING_DIR=./staging
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CAPACITY=50000
MAX_DAILY_CAPACITY=200

# ── 2. Database Configuration ──────────────────────────────────────────
DATABASE_URL=sqlite:///./med_parser.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── 3. Gemini Vision AI ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=models/gemini-3.1-flash-lite-preview
GEMINI_TIMEOUT=30
EXTRACTION_CONCURRENCY_LIMIT=3

# ── 4. Local RPA Automation Bridge ─────────────────────────────────────
AGENT_API_KEY=your_agent_secret_key_here
BRIDGE_PORT=8001
BRIDGE_AGENT_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000
PMS_TARGET_TITLE=Notepad
TYPING_SPEED_MIN=0.01
TYPING_SPEED_MAX=0.02
ABORT_HOTKEY=ctrl+shift+z
RPA_SAVE_HOTKEY=ctrl+s
RPA_CLOSE_HOTKEY=alt+f4
RPA_SELECT_ALL_HOTKEY=ctrl+a

# ── 5. Frontend (Vite Client Bundle Keys) ──────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MED_PARSER_API_KEY=your_secure_api_key_here
VITE_AGENT_API_KEY=your_agent_secret_key_here
